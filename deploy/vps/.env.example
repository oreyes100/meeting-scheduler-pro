# ─── Meeting Scheduler Pro — VPS self-hosted ───────────────────────────────
# Copia este archivo como .env.local en la raíz del proyecto y edita los valores.
# NUNCA subas .env.local al repositorio.

# Secreto para firmar JWTs (mínimo 32 caracteres, genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=cambia-esto-por-una-clave-segura-de-32-chars-o-mas

# Ruta absoluta al archivo SQLite (se crea automáticamente si no existe)
DB_PATH=/opt/msp/data/msp.db

# Entorno
NODE_ENV=production

# Puerto interno (Nginx hace proxy a este puerto; no exponer directamente)
PORT=3000
HOSTNAME=127.0.0.1
